; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Molten Mates"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
Network="*res://scripts/net/network.gd"
Sfx="*res://scripts/core/sfx.gd"
ShotTool="*res://tools/shot_tool.gd"
Juice="*res://scripts/core/juice.gd"
Music="*res://scripts/core/music.gd"
SteamService="*res://scripts/core/steam_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

cutaway_target={
"type": "vec4",
"value": Vector4(0, -100, 0, 0)
}
ph_concrete_d={
"type": "sampler2D",
"value": "res://assets/textures/pbr/concrete_d.jpg"
}
ph_concrete_n={
"type": "sampler2D",
"value": "res://assets/textures/pbr/concrete_n.jpg"
}
